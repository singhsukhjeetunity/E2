#ifndef E2_LONDON_TIME_MQH
#define E2_LONDON_TIME_MQH
// Pinned IANA tzdb 2025b Europe/London, EU rules from 1996.
// Source: https://data.iana.org/time-zones/tzdb-2025b/europe
// Explicit supported UTC coverage: [1996-01-01,2038-01-01).
// Future transitions reflect that pinned release, not automatic legislative updates.
const string E2_LONDON_DATA_ID="Europe/London|IANA-2025b|1996-2038|v1";
const datetime E2_LONDON_FROM=820454400,E2_LONDON_UNTIL=2145916800;
const datetime E2_LONDON_TRANSITIONS[]={828234000,846378000,859683600,877827600,891133200,909277200,922582800,941331600,954032400,972781200,985482000,1004230800,1017536400,1035680400,1048986000,1067130000,1080435600,1099184400,1111885200,1130634000,1143334800,1162083600,1174784400,1193533200,1206838800,1224982800,1238288400,1256432400,1269738000,1288486800,1301187600,1319936400,1332637200,1351386000,1364691600,1382835600,1396141200,1414285200,1427590800,1445734800,1459040400,1477789200,1490490000,1509238800,1521939600,1540688400,1553994000,1572138000,1585443600,1603587600,1616893200,1635642000,1648342800,1667091600,1679792400,1698541200,1711846800,1729990800,1743296400,1761440400,1774746000,1792890000,1806195600,1824944400,1837645200,1856394000,1869094800,1887843600,1901149200,1919293200,1932598800,1950742800,1964048400,1982797200,1995498000,2014246800,2026947600,2045696400,2058397200,2077146000,2090451600,2108595600,2121901200,2140045200};
bool E2UtcToLondon(const datetime utc,datetime &london)
{
   london=0;if(utc<E2_LONDON_FROM||utc>=E2_LONDON_UNTIL)return(false);
   int offset=0;
   for(int i=0;i<ArraySize(E2_LONDON_TRANSITIONS)&&utc>=E2_LONDON_TRANSITIONS[i];i++)offset=(i%2==0?3600:0);
   london=utc+offset;return(true);
}
int E2CalendarDay(const datetime local){MqlDateTime p;if(!TimeToStruct(local,p))return(0);return(p.year*10000+p.mon*100+p.day);}
int E2MinuteOfDay(const datetime local){MqlDateTime p;if(!TimeToStruct(local,p))return(-1);return(p.hour*60+p.min);}
datetime E2LocalMidnight(const datetime local){MqlDateTime p;if(!TimeToStruct(local,p))return(0);p.hour=0;p.min=0;p.sec=0;return(StructToTime(p));}
#endif
