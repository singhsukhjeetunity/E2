#ifndef E2_RESEARCH_E2ADXBBREGIMERESEARCH_MQH
#define E2_RESEARCH_E2ADXBBREGIMERESEARCH_MQH
#include "..\\strategy\\E2ADXBBTypes.mqh"
#include "..\\analysis\\E2MarketData.mqh"
#include "..\\reporting\\E2CsvExporter.mqh"

struct E2ResearchRma {int count;double sum,value;bool valid;};
struct E2ResearchEma {int count;double sum,value;bool valid;};

enum E2ADXBBHybridDecision {E2_HYBRID_SKIP=0,E2_HYBRID_FADE=1,E2_HYBRID_FOLLOW=2};

class E2ADXBBRegimeResearch
  {
private:
   bool m_enabled,m_export_enabled;int m_lookback;string m_symbol,m_run_id,m_hash;double m_buffer_price;E2Config m_config;E2MarketData *m_market;E2Logger *m_logger;E2CsvExporter m_csv;double m_adx[],m_width[],m_atr[],m_ema_separation_atr_history[],m_bb_expansion_2_atr_history[],m_adx_slope2_history[];E2ResearchEma m_ema20,m_ema50;
   string N(const double v,const int d=10)const{return(v!=EMPTY_VALUE&&MathIsValidNumber(v)?DoubleToString(v,d):"");}
   string TS(const datetime t)const{if(t<=0)return("");string s=TimeToString(t,TIME_DATE|TIME_SECONDS);StringReplace(s,".","-");return(s);}
   void Add(const string v,string &r[]){int n=ArraySize(r);ArrayResize(r,n+1);r[n]=v;}
   void Reset(E2ResearchRma &s){s.count=0;s.sum=0;s.value=0;s.valid=false;}void Reset(E2ResearchEma &s){s.count=0;s.sum=0;s.value=0;s.valid=false;}
   bool Rma(E2ResearchRma &s,const double x,const int len){if(!MathIsValidNumber(x)||len<1)return(false);if(!s.valid){s.sum+=x;s.count++;if(s.count<len)return(false);s.value=s.sum/len;s.valid=true;}else s.value=(s.value*(len-1)+x)/len;return(true);}
   bool Ema(E2ResearchEma &s,const double x,const int len){if(!MathIsValidNumber(x)||len<1)return(false);if(!s.valid){s.sum+=x;s.count++;if(s.count<len)return(false);s.value=s.sum/len;s.valid=true;}else s.value+=(2.0/(len+1.0))*(x-s.value);return(true);}
   void Push(double &a[],const double v,const int max_count){int n=ArraySize(a);if(n<max_count){ArrayResize(a,n+1);a[n]=v;return;}for(int i=1;i<n;i++)a[i-1]=a[i];a[n-1]=v;}
   double Prior(const double &a[],const int back)const{int i=ArraySize(a)-back;return(i>=0?a[i]:EMPTY_VALUE);}
   bool Percentile(const double &history[],const double current,double &result)const{result=EMPTY_VALUE;if(current==EMPTY_VALUE||!MathIsValidNumber(current)||ArraySize(history)!=m_lookback)return(false);int less=0,equal=0;for(int i=0;i<m_lookback;i++){double v=history[i];if(v==EMPTY_VALUE||!MathIsValidNumber(v))return(false);if(v<current)less++;else if(v==current)equal++;}result=(less+0.5*equal)/(double)m_lookback;return(true);}
   string MaturityState(const bool available,const double percentile)const{if(!available)return("UNAVAILABLE");if(percentile<0.40)return("LOW");if(percentile<=0.60)return("NEUTRAL");return("HIGH");}
   string ThresholdState(const bool available,const double percentile)const{if(!available)return("UNAVAILABLE");return(percentile<0.25?"WEAK":"ACCEPTABLE");}
   string HybridPolarity(const double maturity,const bool h1_available,const int h1_alignment)const{if(maturity==EMPTY_VALUE||!MathIsValidNumber(maturity)||!h1_available)return("UNAVAILABLE");if(maturity<E2_ADXBB_HYBRID_MATURITY_THRESHOLD_ATR&&h1_alignment==1)return("FOLLOW");if(maturity>=E2_ADXBB_HYBRID_MATURITY_THRESHOLD_ATR&&h1_alignment==-1)return("FADE");return("UNCERTAIN");}
   string HybridQuality(const bool available,const double percentile)const{if(!available)return("UNAVAILABLE");if(percentile<m_config.adxbb_hybrid_quality_threshold)return("LOW");if(percentile<E2_ADXBB_HYBRID_QUALITY_Q75)return("HIGH");return("EXTREME");}
   E2ADXBBHybridDecision HybridDecision(const string polarity,const bool fade_available,const double fade_percentile,const bool follow_available,const double follow_percentile,const double threshold)const{if(polarity=="FADE"&&fade_available&&fade_percentile>=threshold)return(E2_HYBRID_FADE);if(polarity=="FOLLOW"&&follow_available&&follow_percentile>=threshold)return(E2_HYBRID_FOLLOW);return(E2_HYBRID_SKIP);}
   string HybridDecisionName(const E2ADXBBHybridDecision decision)const{if(decision==E2_HYBRID_FADE)return("FADE");if(decision==E2_HYBRID_FOLLOW)return("FOLLOW");return("SKIP");}
   int Alignment(const double fast,const double slow,const E2TradeDirection raw)const{if(fast==EMPTY_VALUE||slow==EMPTY_VALUE||!MathIsValidNumber(fast)||!MathIsValidNumber(slow)||fast==slow)return(0);bool agrees=(raw==E2_DIRECTION_SHORT?fast>slow:fast<slow);return(agrees?1:-1);}
   void Header(string &r[]){string x[]={"run_id","config_hash","candidate_id","signal_time","raw_event_direction","execution_direction","invert_trade_direction","signal_open","signal_high","signal_low","signal_close","adx","adx_prev1","adx_prev2","adx_slope1","adx_slope2","plus_di","minus_di","di_spread_signed","di_spread_absolute","directional_di_advantage","bb_upper","bb_middle","bb_lower","bb_width","bb_width_prev1","bb_width_prev2","bb_width_change1","bb_width_change2","bb_width_atr","atr","atr_prev1","atr_prev2","atr_change1","atr_change2","atr_relative20","candle_range","candle_body","candle_body_atr","candle_body_fraction","breakout_penetration","breakout_penetration_atr","ema20","ema50","ema_separation","ema_separation_atr","ema_directional_alignment","h1_bar_time","h1_adx","h1_adx_prev1","h1_adx_slope1","h1_plus_di","h1_minus_di","h1_atr","h1_ema20","h1_ema50","h1_ema_separation_atr","h1_directional_alignment","ema_separation_atr_percentile","m5_maturity_state","bb_expansion_2_atr","bb_expansion_2_atr_percentile","bb_expansion_state","adx_slope2_percentile","adx_acceleration_state","hybrid_polarity_state","fade_quality_state","follow_quality_state","hybrid_decision_q50","hybrid_decision_q75"};ArrayCopy(r,x);}
   bool H1(const datetime asof,const E2TradeDirection raw,datetime &bar_time,double &adx,double &adx_prev,double &plus,double &minus,double &atr,double &ema20,double &ema50,double &sep_atr,int &alignment)
     {bar_time=0;adx=adx_prev=plus=minus=atr=ema20=ema50=sep_atr=EMPTY_VALUE;alignment=0;if(m_market==NULL)return(false);MqlRates b[];if(!m_market.GetClosedBarsAsOf(m_symbol,PERIOD_H1,asof,300,b))return(false);E2ResearchRma tr,pr,mr,dx,ar;E2ResearchEma e20,e50;Reset(tr);Reset(pr);Reset(mr);Reset(dx);Reset(ar);Reset(e20);Reset(e50);bool have=false;double ph=0,pl=0,pc=0,last_adx=EMPTY_VALUE,previous_adx=EMPTY_VALUE;for(int i=0;i<ArraySize(b);i++){double range=b[i].high-b[i].low,p=0,m=0;if(have){range=MathMax(range,MathMax(MathAbs(b[i].high-pc),MathAbs(b[i].low-pc)));double up=b[i].high-ph,down=pl-b[i].low;if(up>down&&up>0)p=up;else if(down>up&&down>0)m=down;}ph=b[i].high;pl=b[i].low;pc=b[i].close;have=true;bool tv=Rma(tr,range,m_config.adxbb_di_length),pv=Rma(pr,p,m_config.adxbb_di_length),mv=Rma(mr,m,m_config.adxbb_di_length);double dp=EMPTY_VALUE,dm=EMPTY_VALUE;if(tv&&pv&&mv&&tr.value>0){dp=100*pr.value/tr.value;dm=100*mr.value/tr.value;double den=dp+dm;double sample=(den>0?100*MathAbs(dp-dm)/den:0);if(Rma(dx,sample,m_config.adxbb_adx_length)){previous_adx=last_adx;last_adx=dx.value;}}Rma(ar,range,m_config.adxbb_atr_length);Ema(e20,b[i].close,20);Ema(e50,b[i].close,50);if(i==ArraySize(b)-1){bar_time=b[i].time;plus=dp;minus=dm;}}
      if(bar_time<=0||!dx.valid||!ar.valid||!e20.valid||!e50.valid)return(false);adx=last_adx;adx_prev=previous_adx;atr=ar.value;ema20=e20.value;ema50=e50.value;sep_atr=(atr>0?MathAbs(ema20-ema50)/atr:EMPTY_VALUE);alignment=Alignment(ema20,ema50,raw);return(true);}
public:
   E2ADXBBRegimeResearch(void):m_enabled(false),m_export_enabled(false),m_lookback(250),m_symbol(""),m_run_id(""),m_hash(""),m_buffer_price(0.0),m_market(NULL),m_logger(NULL){Reset(m_ema20);Reset(m_ema50);}
   bool Initialize(const E2Config &c,const string symbol,const string run_id,const string hash,const double pip_size,E2MarketData &market,E2Logger &logger){m_export_enabled=c.adxbb_regime_research_enabled;m_enabled=(m_export_enabled||c.adxbb_hybrid_regime_enabled);m_lookback=c.adxbb_regime_percentile_lookback;m_config=c;m_symbol=symbol;m_run_id=run_id;m_hash=hash;m_buffer_price=c.adxbb_bb_buffer_pips*pip_size;m_market=&market;m_logger=&logger;ArrayResize(m_adx,0);ArrayResize(m_width,0);ArrayResize(m_atr,0);ArrayResize(m_ema_separation_atr_history,0);ArrayResize(m_bb_expansion_2_atr_history,0);ArrayResize(m_adx_slope2_history,0);Reset(m_ema20);Reset(m_ema50);if(!m_enabled||!m_export_enabled)return(true);string safe=symbol;StringReplace(safe,"/","_");StringReplace(safe,"\\","_");string base="E2_ADXBB_REGIME_"+safe+"_L"+IntegerToString(m_lookback)+"_"+run_id,file=base+".csv";for(int n=2;FileIsExist(file,FILE_COMMON)&&n<=9999;n++)file=base+"_"+IntegerToString(n)+".csv";if(FileIsExist(file,FILE_COMMON)||!m_csv.Initialize(file,logger)){m_export_enabled=false;logger.Warning("Regime research output is unavailable; production trading remains active.","ADXBB_REGIME_RESEARCH");return(true);}string h[];Header(h);if(!m_csv.WriteHeader(h)){m_csv.Close();m_export_enabled=false;logger.Warning("Regime research header failed; production trading remains active.","ADXBB_REGIME_RESEARCH");return(true);}logger.Info("enabled=1, percentileLookback="+IntegerToString(m_lookback)+", percentileMethod=MIDPOINT_EMPIRICAL_PRIOR_ONLY, referenceBars=N-1_THROUGH_N-LOOKBACK, file="+file+".","ADXBB_REGIME_METHOD");logger.Info("methodology=HYBRID_V1, maturityMetric=EMA20_EMA50_SEPARATION_OVER_ATR, maturityThreshold=0.500000, h1AlignmentSource=RAW_BREAKOUT_DIRECTION, fadeQualityMetric=BB_EXPANSION_2_ATR_PERCENTILE, followQualityMetric=ADX_SLOPE2_PERCENTILE, qualityLevels=Q50_Q75, behavioral=0.","ADXBB_HYBRID_METHOD");return(true);}
   E2ADXBBHybridDecision Observe(const MqlRates &bar,const double adx,const double plus,const double minus,const double upper,const double middle,const double lower,const double atr,const E2TradeDirection raw)
     // Causal order: derive N, rank it against N-1..N-lookback, export N if eligible,
     // then append N. Invalid placeholders remain in the window and prevent partial ranks.
     {if(!m_enabled)return(E2_HYBRID_SKIP);Ema(m_ema20,bar.close,20);Ema(m_ema50,bar.close,50);double width=(upper!=EMPTY_VALUE&&lower!=EMPTY_VALUE&&MathIsValidNumber(upper)&&MathIsValidNumber(lower)?upper-lower:EMPTY_VALUE);double ap1=Prior(m_adx,1),ap2=Prior(m_adx,2),wp1=Prior(m_width,1),wp2=Prior(m_width,2),tp1=Prior(m_atr,1),tp2=Prior(m_atr,2);double sep=(m_ema20.valid&&m_ema50.valid?m_ema20.value-m_ema50.value:EMPTY_VALUE);double ema_separation_atr=(atr!=EMPTY_VALUE&&MathIsValidNumber(atr)&&atr>0.0&&sep!=EMPTY_VALUE?MathAbs(sep)/atr:EMPTY_VALUE);double bb_expansion_2_atr=(atr!=EMPTY_VALUE&&MathIsValidNumber(atr)&&atr>0.0&&width!=EMPTY_VALUE&&wp2!=EMPTY_VALUE?(width-wp2)/atr:EMPTY_VALUE);double adx_slope2=(adx!=EMPTY_VALUE&&MathIsValidNumber(adx)&&ap2!=EMPTY_VALUE?adx-ap2:EMPTY_VALUE);double maturity_percentile,bb_expansion_percentile,adx_slope2_percentile;bool maturity_available=Percentile(m_ema_separation_atr_history,ema_separation_atr,maturity_percentile);bool bb_expansion_available=Percentile(m_bb_expansion_2_atr_history,bb_expansion_2_atr,bb_expansion_percentile);bool adx_acceleration_available=Percentile(m_adx_slope2_history,adx_slope2,adx_slope2_percentile);E2ADXBBHybridDecision decision_q50=E2_HYBRID_SKIP;if(raw!=E2_DIRECTION_NONE){double mean=0;bool mean_ok=ArraySize(m_atr)>=20;for(int i=MathMax(0,ArraySize(m_atr)-20);i<ArraySize(m_atr);i++){if(m_atr[i]==EMPTY_VALUE||m_atr[i]<=0)mean_ok=false;else mean+=m_atr[i];}if(mean_ok)mean/=20.0;double range=bar.high-bar.low,body=MathAbs(bar.close-bar.open);double signed_spread=plus-minus,adv=(raw==E2_DIRECTION_SHORT?signed_spread:-signed_spread);datetime ht;double ha,hap,hp,hm,hat,he20,he50,hsep;int halign;bool h1_available=H1(bar.time+PeriodSeconds(PERIOD_M5),raw,ht,ha,hap,hp,hm,hat,he20,he50,hsep,halign);string hybrid_polarity=HybridPolarity(ema_separation_atr,h1_available,halign);string fade_quality=HybridQuality(bb_expansion_available,bb_expansion_percentile);string follow_quality=HybridQuality(adx_acceleration_available,adx_slope2_percentile);decision_q50=HybridDecision(hybrid_polarity,bb_expansion_available,bb_expansion_percentile,adx_acceleration_available,adx_slope2_percentile,m_config.adxbb_hybrid_quality_threshold);E2ADXBBHybridDecision decision_q75=HybridDecision(hybrid_polarity,bb_expansion_available,bb_expansion_percentile,adx_acceleration_available,adx_slope2_percentile,E2_ADXBB_HYBRID_QUALITY_Q75);E2TradeDirection execution;if(m_config.adxbb_hybrid_regime_enabled)execution=(decision_q50==E2_HYBRID_FADE?raw:(decision_q50==E2_HYBRID_FOLLOW?(raw==E2_DIRECTION_LONG?E2_DIRECTION_SHORT:E2_DIRECTION_LONG):E2_DIRECTION_NONE));else execution=(!m_config.adxbb_invert_trade_direction?raw:(raw==E2_DIRECTION_LONG?E2_DIRECTION_SHORT:E2_DIRECTION_LONG));string id="ADXBB|"+m_symbol+"|M5|"+IntegerToString((int)bar.time)+"|"+E2TradeDirectionName(raw);string r[];Add(m_run_id,r);Add(m_hash,r);Add(id,r);Add(TS(bar.time),r);Add(E2TradeDirectionName(raw),r);Add(E2TradeDirectionName(execution),r);Add(IntegerToString((int)m_config.adxbb_invert_trade_direction),r);Add(N(bar.open),r);Add(N(bar.high),r);Add(N(bar.low),r);Add(N(bar.close),r);Add(N(adx),r);Add(N(ap1),r);Add(N(ap2),r);Add(N(ap1!=EMPTY_VALUE?adx-ap1:EMPTY_VALUE),r);Add(N(adx_slope2),r);Add(N(plus),r);Add(N(minus),r);Add(N(signed_spread),r);Add(N(MathAbs(signed_spread)),r);Add(N(adv),r);Add(N(upper),r);Add(N(middle),r);Add(N(lower),r);Add(N(width),r);Add(N(wp1),r);Add(N(wp2),r);Add(N(wp1!=EMPTY_VALUE?width-wp1:EMPTY_VALUE),r);Add(N(wp2!=EMPTY_VALUE?width-wp2:EMPTY_VALUE),r);Add(N(atr>0?width/atr:EMPTY_VALUE),r);Add(N(atr),r);Add(N(tp1),r);Add(N(tp2),r);Add(N(tp1!=EMPTY_VALUE?atr-tp1:EMPTY_VALUE),r);Add(N(tp2!=EMPTY_VALUE?atr-tp2:EMPTY_VALUE),r);Add(N(mean_ok&&mean>0?atr/mean:EMPTY_VALUE),r);Add(N(range),r);Add(N(body),r);Add(N(atr>0?body/atr:EMPTY_VALUE),r);Add(N(range>0?body/range:EMPTY_VALUE),r);double event_threshold=(raw==E2_DIRECTION_SHORT?upper+m_buffer_price:lower-m_buffer_price);double event_penetration=(raw==E2_DIRECTION_SHORT?bar.close-event_threshold:event_threshold-bar.close);Add(N(event_penetration),r);Add(N(atr>0?event_penetration/atr:EMPTY_VALUE),r);Add(N(m_ema20.valid?m_ema20.value:EMPTY_VALUE),r);Add(N(m_ema50.valid?m_ema50.value:EMPTY_VALUE),r);Add(N(sep),r);Add(N(ema_separation_atr),r);Add(IntegerToString(Alignment(m_ema20.value,m_ema50.value,raw)),r);Add(TS(ht),r);Add(N(ha),r);Add(N(hap),r);Add(N(hap!=EMPTY_VALUE?ha-hap:EMPTY_VALUE),r);Add(N(hp),r);Add(N(hm),r);Add(N(hat),r);Add(N(he20),r);Add(N(he50),r);Add(N(hsep),r);Add(IntegerToString(halign),r);Add(N(maturity_percentile),r);Add(MaturityState(maturity_available,maturity_percentile),r);Add(N(bb_expansion_2_atr),r);Add(N(bb_expansion_percentile),r);Add(ThresholdState(bb_expansion_available,bb_expansion_percentile),r);Add(N(adx_slope2_percentile),r);Add(ThresholdState(adx_acceleration_available,adx_slope2_percentile),r);Add(hybrid_polarity,r);Add(fade_quality,r);Add(follow_quality,r);Add(HybridDecisionName(decision_q50),r);Add(HybridDecisionName(decision_q75),r);if(m_export_enabled)m_csv.WriteRow(r);}Push(m_ema_separation_atr_history,ema_separation_atr,m_lookback);Push(m_bb_expansion_2_atr_history,bb_expansion_2_atr,m_lookback);Push(m_adx_slope2_history,adx_slope2,m_lookback);Push(m_adx,adx,20);Push(m_width,width,20);Push(m_atr,atr,20);return(decision_q50);}
   void Shutdown(){m_csv.Close();}
  };
#endif
